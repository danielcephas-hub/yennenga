outputs/audit/*
outputs/controles/*
outputs/tableau_de_bord/*
/depot/

# Divers
*.local.txt
.env
*.log
~$*

# Documentation générée par python -m dcb.documentation
docs/documentation.html
docs/documentation.pdf

